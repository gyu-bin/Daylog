<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key><string>RoutiMori</string>
    <!-- Finder·Dock이 ko.lproj/InfoPlist.strings의 현지화 이름(RoutiMori)을 쓰게 한다. 번들 파일 이름(Daylog.app)·식별자는 그대로다. -->
    <key>LSHasLocalizedDisplayName</key><true/>
    <!-- 앱 안의 업데이트(Sparkle). 공개 키는 로그인 키체인의 배포용 서명 키와 짝이다(개인 키는 저장소에 없다). docs/UPDATES.md -->
    <key>DaylogUpdatesEnabled</key><true/>
    <key>SUFeedURL</key><string>https://github.com/gyu-bin/Daylog/releases/latest/download/appcast.xml</string>
    <key>SUPublicEDKey</key><string>rKafcD0rs6p4xr+T3+dW+Sz88gg2sQUO7MKmL/+xTQs=</string>
    <key>SUEnableInstallerLauncherService</key><true/>
    <key>SUEnableDownloaderService</key><true/>
    <key>SUVerifyUpdateBeforeExtraction</key><true/>
    <!-- 하루에 한 번쯤 새 버전을 확인한다(설정에서 끌 수 있다). 설치는 늘 사용자가 승인한다. -->
    <key>SUEnableAutomaticChecks</key><true/>
    <key>SUScheduledCheckInterval</key><integer>86400</integer>
    <key>SUAutomaticallyUpdate</key><false/>
    <!-- Daylog 루틴 템플릿 파일(.daylogtemplate, 내용은 JSON). 파일을 열면 Daylog가 미리보기를 띄운다. -->
    <key>UTExportedTypeDeclarations</key>
    <array>
        <dict>
            <key>UTTypeIdentifier</key><string>com.mungyubin.daylog.template</string>
            <key>UTTypeDescription</key><string>RoutiMori 루틴 템플릿</string>
            <key>UTTypeConformsTo</key>
            <array><string>public.json</string></array>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key>
                <array><string>daylogtemplate</string></array>
                <key>public.mime-type</key>
                <array><string>application/vnd.daylog.template+json</string></array>
            </dict>
        </dict>
    </array>
    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeName</key><string>RoutiMori 루틴 템플릿</string>
            <key>CFBundleTypeRole</key><string>Viewer</string>
            <key>LSHandlerRank</key><string>Owner</string>
            <key>LSItemContentTypes</key>
            <array><string>com.mungyubin.daylog.template</string></array>
        </dict>
    </array>
</dict>
</plist>
