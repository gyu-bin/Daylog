<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Mac App Store판. DMG판(Config/Daylog.entitlements)과 같은 iCloud 저장소를 쓰되, 번들 ID가 달라 컨테이너 이름을 직접 적는다.
	     Sparkle용 임시 예외는 넣지 않는다(Mac App Store 심사). -->
	<key>com.apple.developer.aps-environment</key>
	<string>development</string>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.com.mungyubin.daylog</string>
	</array>
	<!-- 입은 옷을 같은 계정의 기기끼리 맞춘다(iCloud 키-값 저장소, PioWardrobeCloudSelection). iOS·Mac App Store판이 같은 저장소. -->
	<key>com.apple.developer.ubiquity-kvstore-identifier</key>
	<string>$(TeamIdentifierPrefix)com.mungyubin.daylog.ios</string>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
</dict>
</plist>
